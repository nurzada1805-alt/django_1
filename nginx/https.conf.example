# Боевой вариант nginx/default.conf с HTTPS. Замени notes.kg на свой домен.
upstream django {
    server web:8000;
}
# HTTP: только проверка certbot и перенаправление на HTTPS

server {
    listen 80;
    server_name notes.kg;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
location / {
    return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl;
    http2 on;
    server_name notes.kg;
    ssl_certificate /etc/letsencrypt/live/notes.kg/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/notes.kg/privkey.pem;
    server_tokens off;
    client_max_body_size 3m;
    location /static/ {
        alias /var/www/static/;
        expires 30d;
    }
location /media/ {
    alias /var/www/media/;
}
location / {
    proxy_pass http://django;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    }
}