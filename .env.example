# Скопируй в .env и заполни. Сам .env в git не попадает.
# Значения пиши без кавычек и без комментариев в конце строки.
SECRET_KEY=change-me
DEBUG=False
# localhost нужен для healthcheck внутри контейнера
ALLOWED_HOSTS=localhost,127.0.0.1
# Для контейнера postgres (и для DATABASE_URL внутри compose)
POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me-too
# Только для запуска runserver на своём компьютере, когда база и Redis в Docker
# DATABASE_URL=postgres://notes:change-me-too@localhost:5432/notes
# CACHE_URL=redis://localhost:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost
GUNICORN_WORKERS=3
